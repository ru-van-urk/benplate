# Docker Compose settings: copy to .env for `pnpm run docker:up`, set the same values on your host
# Only read on the first start of the postgres_data volume; keep it alphanumeric (e.g. `openssl rand -hex 32`)
POSTGRES_PASSWORD=

# Only needed for an external Postgres; by default the URL is built from POSTGRES_PASSWORD and the `db` service
# DATABASE_URL=postgres://user:password@host:5432/benplate

# The host port `web` is published on; default 3030
# WEB_PORT=3030

# The public URL of the app, as the browser sees it: https://<domain> deployed, http://localhost:3030 locally (WEB_PORT)
APP_URL=
# Signs sessions; at least 32 characters (`openssl rand -hex 32`). Changing it signs everyone out
BETTER_AUTH_SECRET=
# Closes sign-up, e.g. once your own account exists
# AUTH_DISABLE_SIGNUP=true

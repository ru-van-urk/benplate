{
  "name": "@maribor/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "db:local": "turso dev --db-file ../../.data/local.db",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "git clean -xdf .cache .turbo dist node_modules"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.23.1",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@maribor/oxlint-config": "workspace:*",
    "@maribor/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "catalog:",
    "oxlint": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  }
}

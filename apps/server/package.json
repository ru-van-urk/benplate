{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "clean": "git clean -xdf .cache .turbo dist node_modules"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@maribor/api": "workspace:*",
    "@maribor/db": "workspace:*",
    "@orpc/json-schema": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/valibot": "catalog:",
    "hono": "^4.13.7",
    "libsql": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@maribor/oxlint-config": "workspace:*",
    "@maribor/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  }
}

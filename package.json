{
  "name": "maribor",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm knip",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "postclean": "git clean -xdf .cache .turbo node_modules",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @maribor/db --",
    "db:studio": "turbo run db:studio -F @maribor/db --",
    "db:generate": "turbo run db:generate -F @maribor/db --",
    "db:migrate": "turbo run db:migrate -F @maribor/db --",
    "db:local": "turbo run db:local -F @maribor/db --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "typecheck": "turbo run typecheck && tsc",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "deps:check": "taze",
    "deps:update": "taze -w"
  },
  "devDependencies": {
    "@maribor/oxfmt-config": "workspace:*",
    "@maribor/oxlint-config": "workspace:*",
    "@maribor/typescript-config": "workspace:*",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "taze": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@12.6.0"
}

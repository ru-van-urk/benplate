{
  "name": "maribor",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @maribor/db --",
    "db:studio": "turbo run db:studio -F @maribor/db --",
    "db:generate": "turbo run db:generate -F @maribor/db --",
    "db:migrate": "turbo run db:migrate -F @maribor/db --",
    "db:local": "turbo run db:local -F @maribor/db --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "oxlint -c tooling/oxlint/base.ts && oxfmt -c tooling/oxfmt/base.ts --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@maribor/oxfmt-config": "workspace:*",
    "@maribor/oxlint-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.6.0"
}
